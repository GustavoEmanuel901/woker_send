# Use uma senha forte e substitua este valor localmente.
MSSQL_SA_PASSWORD=ReplaceWithAStrongLocalPassword123!

DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=ReplaceWithAStrongLocalPassword123!
DB_NAME=pay

STORAGE_DRIVER=local
APP_URL=http://localhost:3333

# Opcional: para usar o mock S3 do docker-compose, altere STORAGE_DRIVER para s3.
S3_ENDPOINT=http://localhost:9091
S3_REGION=us-east-1
S3_BUCKET=pay-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9091

# O provedor de extração requer uma chave quando for usado.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=15000

# Configure se for executar fluxos que enviam e-mail.
MAILTRAP_HOST=
MAILTRAP_PORT=
# Use as credenciais SMTP da sua conta Mailtrap.
MAILTRAP_USER=
MAILTRAP_PASS=
