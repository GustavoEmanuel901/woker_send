generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlserver"
}

model User {
  id       Int     @id @default(autoincrement())
  name     String
  email    String  @unique
  phone    String?
  jobtitle String?
  abstract String?
  fileId   Int     @unique
  file     File    @relation(fields: [fileId], references: [id])

  @@map("users")
}

model File {
  id   Int    @id @default(autoincrement())
  name String
  size Int
  key  String
  url  String

  user User?

  @@map("files")
}
